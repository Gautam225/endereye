# ─────────────────────────────────────────────────────────────────────────────
# Eye of Ender — environment settings
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Each build step adds its own settings here (see docs/ROADMAP.md).
# Keep comments on their own lines; don't put them after a value.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Eye of Ender"
# development | production
APP_ENV=development
APP_DEBUG=true
# Long random string (32+ characters) used to sign login tokens. Required.
# Changing it signs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# How long a sign-in lasts: access token (minutes) and refresh cookie (days, renewed on use)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma-separated list of allowed frontend URLs (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL (app data + pgvector) ─────────────────────────────────────────
# One line:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#   for example  postgresql://postgres:your-password@localhost:5432/eye_of_ender
# If the password has special characters, write them URL-encoded:
#   @ -> %40   : -> %3A   / -> %2F   # -> %23   % -> %25   space -> %20
# Easiest: in the backend folder run `python scripts/setup_database.py`; it creates the
# database and writes this line for you (see docs/ROADMAP.md, Step 0).
DATABASE_URL=

# ── LLM primary: OpenRouter (keys rotated round-robin) ───────────────────────
# Add more keys as OPENROUTER_API_KEY_5, _6, ... — no code change needed.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated, tried in order. "smart" = SQL writing/repair, "fast" = everything else.
# Free models (":free"). Free limits are per ACCOUNT, not per key. See docs/ROADMAP.md 4.1.
OPENROUTER_MODELS_SMART=thinkingmachines/inkling:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODELS_FAST=thinkingmachines/inkling-small:free,nvidia/nemotron-3.5-lightning:free

# ── LLM fallback: Groq (used only when every OpenRouter key fails) ───────────
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Current model list: https://console.groq.com/docs/models
# Free plan: limits are per organization and per model (about 30 requests/min, 8,000 tokens/min).
# A second model is tried when the first one cannot handle a request
GROQ_MODELS_SMART=openai/gpt-oss-120b,llama-3.3-70b-versatile
GROQ_MODELS_FAST=openai/gpt-oss-20b
# Prompts estimated above this many tokens skip Groq (its free plan allows 8,000 tokens/minute)
GROQ_MAX_PROMPT_TOKENS=6000

# ── LLM behaviour ────────────────────────────────────────────────────────────
# Max seconds for one attempt (one key, one model)
LLM_ATTEMPT_TIMEOUT_SECONDS=60
# Max seconds for all attempts of one call together (all keys, models, providers)
LLM_TOTAL_TIMEOUT_SECONDS=120
# Rest for a rate-limited key when the provider doesn't say how long; doubles on repeat
LLM_RATE_LIMIT_COOLDOWN_SECONDS=60

# ── Embeddings (local on CPU, used from Step 6) ──────────────────────────────
# Runs on this machine via fastembed: free, no API calls, data stays local.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Re-orders the best candidates (a "cross-encoder"). Also local.
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Where model files are cached (keep the path short: Windows limits paths to 260 characters)
MODELS_DIR=./data/models
# How PDFs, Word, PowerPoint, Excel and HTML are turned into Markdown: markitdown or docling.
# See the parser bake-off in docs/ROADMAP.md, Step 6.
DOCUMENT_PARSER=markitdown
# Read pictures with OCR on this server (nothing is sent out): scanned PDF pages, the words in
# charts, and image files (PNG, JPG, TIFF...). Needs rapidocr-onnxruntime (in requirements.txt).
DOCUMENT_OCR=true
# Most pages read with OCR per document; further pages are listed as "not read". Slow: 1-5 s a page.
DOCUMENT_OCR_MAX_PAGES=100
# Text per chunk, in tokens of the embedding model (its limit is 512, and the header counts)
CHUNK_TOKENS=450
# Tokens repeated between neighbouring chunks of the same section (0 to 50)
CHUNK_OVERLAP_TOKENS=40
# Candidates the reranker scores below this are dropped (the best 5 are always kept)
RERANK_THRESHOLD=0.0

# ── Databricks (optional: Unity Catalog Delta tables + UC Volumes) ───────────
# Leave empty if you don't use Databricks. Uploaded files and Delta tables by
# path work without it.
# Workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=
# Access token; a token with SELECT-only access is recommended
DATABRICKS_TOKEN=
# SQL Warehouse → Connection details → the HTTP path ends with this ID
DATABRICKS_WAREHOUSE_ID=

# ── Storage ──────────────────────────────────────────────────────────────────
# Uploads (stored as Parquet), caches. Relative paths start at the project folder.
DATA_DIR=./data
# Largest file that can be uploaded to a space, in MB
MAX_UPLOAD_MB=200
# Folders that local Delta tables may be added from, comma-separated (DATA_DIR always counts).
# Example: LOCAL_DATA_ROOTS=D:\lakehouse,C:\shared\delta
LOCAL_DATA_ROOTS=

# ── Queries ──────────────────────────────────────────────────────────────────
# A query that runs longer than this is stopped
QUERY_TIMEOUT_SECONDS=60
# At most this many rows come back from one query
QUERY_MAX_ROWS=10000
# Profiling a table (statistics, searchable values) or detecting joins is stopped after this
PROFILE_TIMEOUT_SECONDS=120

# ── External databases (connections) ─────────────────────────────────────────
# Encrypts the stored database passwords (AES-256-GCM). Keep it secret and back it up: without
# it the saved passwords cannot be read. Make one with:
#   python -c "from app.core.vault import generate_key; print(generate_key())"
CONNECTION_ENCRYPTION_KEY=
# After changing the key, keep the old one here until every connection has been saved again.
CONNECTION_ENCRYPTION_KEY_PREVIOUS=
# Optional: only these host names may be used (comma-separated). Empty = any host that passes
# the checks (no loopback, link-local or cloud-metadata addresses, never this app's own database).
EXTERNAL_DB_ALLOWED_HOSTS=
# Hosts on private networks (10.x, 192.168.x, 172.16-31.x) are allowed by default.
EXTERNAL_DB_ALLOW_PRIVATE=true
# This machine itself (localhost). For development only; keep false in production.
EXTERNAL_DB_ALLOW_LOOPBACK=false
EXTERNAL_DB_CONNECT_TIMEOUT_SECONDS=5

# ── Single sign-on (OpenID Connect) ──────────────────────────────────────────
# Works with Okta, Microsoft Entra ID, Google Workspace, Keycloak, Auth0 and any OIDC provider.
# Register this app there as a "web" application with the redirect URL:
#   <PUBLIC_URL>/api/v1/auth/sso/callback
# and fill in the three values below. Leave them empty to keep email-and-password only.
PUBLIC_URL=http://localhost:5173
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_NAME=Single sign-on
# Optional: only these email domains may sign in (comma-separated). Empty = any.
SSO_ALLOWED_DOMAINS=
# Make an account the first time someone signs in (with the role below)? false = admins add people first.
SSO_AUTO_CREATE=true
SSO_DEFAULT_ROLE=viewer
# false hides the email-and-password form. Keep it true until SSO works for an admin.
SSO_PASSWORD_LOGIN=true

# ── Reports and email ────────────────────────────────────────────────────────
# Scheduled reports are sent by email when SMTP_HOST is set. Without it they are still made on
# schedule and can be downloaded from the Reports page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none (a trusted local relay only)
SMTP_SECURITY=starttls
# Optional: reports may only be sent to these email domains (comma-separated). Empty = any.
REPORT_ALLOWED_EMAIL_DOMAINS=
